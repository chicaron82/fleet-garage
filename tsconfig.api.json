{
  // Vercel serverless functions (the "Hey FG" proxy). Node runtime, not the Vite
  // app — its own project so `tsc -b` (the real gate) type-checks api/ without
  // pulling DOM/Vite libs. Mirrors tsconfig.node.json's bundler-mode settings.
  "compilerOptions": {
    // Stated, not inherited: the gate's strictness must not hang on a TypeScript version default (TS 6 made it one).
    // ⚠️ Vercel's function builder does NOT read this file's strictness: it type-checks api/ NON-strict (same TS 6.0.2;
    // its own options). So api code must type-check both ways: narrow with `in` or a type guard, never a boolean
    // discriminant or `x && typeof x === 'object'`, which only narrow under strict. Check: `npx tsc --noEmit -p
    // tsconfig.api.json --strict false` (2026-11-12, /reflect 92: three such errors had sat in every build log).
    "strict": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api"]
}
